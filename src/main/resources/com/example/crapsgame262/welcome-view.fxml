<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" spacing="20.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.crapsgame262.controllers.WelcomeController">
   <children>
      <Label text="Nombre de Usuario">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
      <TextField fx:id="textFieldNickname" maxWidth="-Infinity" prefHeight="24.0" prefWidth="200.0" />
      <Button mnemonicParsing="false" onMouseClicked="#onMouseClickedBtnStart" text="Iniciar">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
   </children>
</VBox>
